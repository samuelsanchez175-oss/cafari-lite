// Signing lives here so building never dirties the project file.
//
// Copy Local.xcconfig.example to Local.xcconfig if you need to override team
// or bundle id. Local.xcconfig is git-ignored, so `git status` stays clean.

// Canonical App ID (same entitled CarPlay App ID as Car Reels).
CAFARI_LITE_BUNDLE_ID = com.samuelsanchez.ytos27

// Your ten-character Apple Developer team, e.g. ABCDE12345. Empty means Xcode
// falls back to whatever it can find, which is fine for a phone-only build.
CAFARI_LITE_TEAM =

// CarPlay entitlements wired by default. Override in Local.xcconfig only if
// you need a phone-only build without CarPlay signing.
CAFARI_LITE_ENTITLEMENTS = CarPlay.entitlements

// Your own settings win: this include is optional and comes last.
#include? "Local.xcconfig"
